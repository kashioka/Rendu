{
  "name": "rendu",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles app",
    "build:dmg": "tauri build --bundles app,dmg",
    "install:local": "npm run build && cp -R src-tauri/target/release/bundle/macos/Rendu.app /Applications/ && rm -rf src-tauri/target/release/bundle && echo 'Installed /Applications/Rendu.app'",
    "lint": "eslint .",
    "preview": "vite preview",
    "vite:dev": "vite",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "vite:build": "tsc -b && vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "highlight.js": "^11.12.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.17.0",
    "mermaid": "^11.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
